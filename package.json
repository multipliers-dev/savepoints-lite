{
  "name": "@multipliers-dev/savepoints-lite",
  "version": "2.2.0",
  "description": "Savepoints router and Notion provider skills for append-only session logging via Notion MCP, with optional deterministic post-write validation",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multipliers-dev/savepoints-lite.git"
  },
  "homepage": "https://github.com/multipliers-dev/savepoints-lite",
  "bugs": {
    "url": "https://github.com/multipliers-dev/savepoints-lite/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "savepoints-lite-validate": "./skills/bin/savepoints-lite-validate.mjs"
  },
  "files": [
    "skills/**",
    "templates/**",
    "README.md",
    "LICENSE",
    "docs/adopt.md",
    "docs/architecture.md",
    "docs/publishing.md"
  ],
  "scripts": {
    "build": "node scripts/build-validate.mjs",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "verify": "npm run build && sh scripts/verify-package-contents.sh",
    "validate:plans": "plan-validator --repo-root . --allow-empty",
    "prepare": "sh scripts/prepare-git-hooks.sh",
    "verify:git-hooks": "sh scripts/verify-git-hooks.sh"
  },
  "devDependencies": {
    "@multipliers-dev/plan-validator": "0.1.0",
    "@multipliers-dev/savepoints-lite": "2.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
