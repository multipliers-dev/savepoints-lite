  "fields": {
    "title": {
      "property": "Name",
      "type": "title",
      "set_on_create": "always"
    },
    "repository": {
      "property": "Repository",
      "type": "text",
      "set_on_create": "always"
    },
    "agent": {
      "property": "Agent",
      "type": "text",
      "set_on_create": "always"
    },
    "session_id": {
      "property": "Session ID",
      "type": "text",
      "set_on_create": "when_known"
    }
  },
  "system": {
