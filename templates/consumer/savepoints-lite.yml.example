# Optional consumer override — copy to .agents/savepoints-lite.yml.
# Overrides packaged skills/savepoints/defaults.yml for storage.provider and
# validation.post_write when the calling integration did not supply those keys.
# Precedence for validation.post_write: integration context → this file → defaults.

storage:
  provider: notion

validation:
  # When true, verification tooling and guidance are available: after a
  # confirmed Notion create the agent may read back the page and run
  # savepoints-lite-validate on it (at most one repair). Optional per append.
  # Default / absent: false (instruction-only persistence; no CLI required).
  # Integration surface for your own hooks or automation: structured JSON
  # input, JSON output, and exit codes.
  # Integrations (e.g. marketplace wrapper) may enable this via tier-1 handoff
  # without requiring this file in every consumer repository.
  post_write: false
